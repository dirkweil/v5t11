<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_3.xsd" version="2.3">
  <navigation-rule>
    <from-view-id>/view/fahrzeugList.xhtml</from-view-id>

    <navigation-case>
      <from-outcome>control</from-outcome>
      <to-view-id>/view/fahrzeugControl.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>create</from-outcome>
      <to-view-id>/view/fahrzeugCreate.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>gleisParameter</from-outcome>
      <to-view-id>/view/gleisParameter.xhtml</to-view-id>
      <redirect/>
    </navigation-case>
  </navigation-rule>

  <navigation-rule>
    <from-view-id>/view/fahrzeugControl.xhtml</from-view-id>

    <navigation-case>
      <from-outcome>editBasics</from-outcome>
      <to-view-id>/view/fahrzeugBasics.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>editPosition</from-outcome>
      <to-view-id>/view/fahrzeugPosition.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>editTraktion</from-outcome>
      <to-view-id>/view/fahrzeugTraktion.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>editFunktionen</from-outcome>
      <to-view-id>/view/fahrzeugFunction.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>editKonfiguration</from-outcome>
      <to-view-id>/view/fahrzeugProgram.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>fahrzeugMessung</from-outcome>
      <to-view-id>/view/fahrzeugMessung.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>gleisMessung</from-outcome>
      <to-view-id>/view/gleisMessung.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>remove</from-outcome>
      <to-view-id>/view/fahrzeugRemoveConfirm.xhtml</to-view-id>
      <redirect/>
    </navigation-case>

    <navigation-case>
      <from-outcome>finished</from-outcome>
      <to-view-id>/view/fahrzeugList.xhtml</to-view-id>
      <redirect/>
    </navigation-case>
  </navigation-rule>

  <navigation-rule>
    <from-view-id>/view/fahrzeugRemoveConfirm.xhtml</from-view-id>
    <navigation-case>
      <from-outcome>finished</from-outcome>
      <to-view-id>/view/fahrzeugList.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>

  <navigation-rule>
    <from-view-id>/view/fahrzeugCreate.xhtml</from-view-id>
    <navigation-case>
      <from-outcome>inserted</from-outcome>
      <to-view-id>/view/fahrzeugControl.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>finished</from-outcome>
      <to-view-id>/view/fahrzeugList.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>

  <navigation-rule>
    <from-view-id>/view/*</from-view-id>

    <navigation-case>
      <from-outcome>finished</from-outcome>
      <to-view-id>/view/fahrzeugControl.xhtml</to-view-id>
      <redirect/>
    </navigation-case>
  </navigation-rule>

  <factory>
    <exception-handler-factory>de.gedoplan.v5t11.util.jsf.ViewExpiredExceptionHandlerFactory</exception-handler-factory>
  </factory>
</faces-config>
